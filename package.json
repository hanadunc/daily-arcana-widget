{
  "name": "daily-arcana-widget",
  "version": "2.0.0",
  "description": "Desktop Tarot Card Reader Widget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.dailyarcana.widget",
    "productName": "Daily Arcana",
    "win": {
      "target": "portable"
    },
    "files": [
      "**/*"
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0"

  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}
